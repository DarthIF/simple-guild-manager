{
	"name": "simple-team-builder",
	"private": true,
	"version": "0.0.2",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"smui-prepare": "npm run smui-theme-light && npm run smui-theme-dark",
		"smui-theme-light": "smui-theme compile static/smui.css -i src/theme",
		"smui-theme-dark": "smui-theme compile static/smui-dark.css -i src/theme/dark"
	},
	"devDependencies": {
		"@material/typography": "^14.0.0",
		"@smui-extra/badge": "^8.0.3",
		"@smui/button": "^8.0.3",
		"@smui/card": "^8.0.3",
		"@smui/chips": "^8.0.3",
		"@smui/circular-progress": "^8.0.3",
		"@smui/data-table": "^8.0.3",
		"@smui/drawer": "^8.0.3",
		"@smui/fab": "^8.0.3",
		"@smui/icon-button": "^8.0.3",
		"@smui/layout-grid": "^8.0.3",
		"@smui/list": "^8.0.3",
		"@smui/ripple": "^8.0.3",
		"@smui/segmented-button": "^8.0.3",
		"@smui/snackbar": "^8.0.3",
		"@smui/tab": "^8.0.3",
		"@smui/tab-bar": "^8.0.3",
		"@smui/textfield": "^8.0.3",
		"@smui/tooltip": "^8.0.3",
		"@smui/top-app-bar": "^8.0.3",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.48.4",
		"@sveltejs/vite-plugin-svelte": "^6.2.1",
		"@types/file-saver": "^2.0.7",
		"@types/luxon": "^3.7.1",
		"@types/node": "^24.3.0",
		"@zumer/snapdom": "^1.9.9",
		"animate.css": "^4.1.1",
		"bcryptjs": "^3.0.2",
		"dotenv": "^17.2.1",
		"file-saver": "^2.0.5",
		"http-status-codes": "^2.3.0",
		"js-base64": "^3.7.8",
		"luxon": "^3.7.2",
		"mongodb": "^6.19.0",
		"smui-theme": "^8.0.3",
		"svelte": "^5.43.6",
		"svelte-check": "^4.3.4",
		"svelte-material-ui": "^8.0.3",
		"sveltekit-sse": "^0.14.3",
		"typescript": "^5.9.3",
		"vite": "^7.2.2"
	}
}